#!/bin/sh
# Call Codex only with the ChatGPT login. Refuse and stop otherwise.
#
#   codex-safe check            check logins, settings, and spending guard
#   codex-safe read  "message"  Codex reads and answers without changing anything
#   codex-safe code  "message"  Codex edits the project without committing
#   codex-safe review <sha>     Codex reviews a commit
#   codex-safe forget           start fresh on the next request
#
# The message can also come from DUO_MESSAGE, without a second argument.
# Codex keeps the conversation between calls in the same project.
# Option: DUO_MODEL=<model> to choose another model.
# Option: DUO_IGNORE_QUOTA=1 to ignore the quota at the user's explicit request.
set -u
. "$(dirname "$0")/common.sh"

# DUO_ACTIVE must reach Codex commands regardless of its environment policy.
config='-c forced_login_method="chatgpt" -c model_provider="openai" -c shell_environment_policy.set.DUO_ACTIVE="1" -c shell_environment_policy.include_only=[]'
model=${DUO_MODEL:+-m $DUO_MODEL}

# Run Codex and show only its final answer. Keep the full log
# to help explain failures, including quota limits.
talk() {
  refuse_nested
  check_codex
  memory=$(memory_file codex)
  session=$(recent_session codex)
  log=$(temporary duo-codex) answer=$(temporary duo-codex-answer)
  # shellcheck disable=SC2086
  if [ -n "$session" ]; then
    safe_env "$CODEX" exec resume $config -c "sandbox_mode=\"$1\"" $model \
      --json -o "$answer" "$session" - >"$log" 2>&1 <"$2"
  else
    safe_env "$CODEX" exec $config --sandbox "$1" $model \
      --json -o "$answer" - >"$log" 2>&1 <"$2"
  fi
  code=$?
  # Record even after a failure: the call may have used tokens.
  if [ -z "$session" ]; then
    sed -n 's/.*"thread_id":"\([^"]*\)".*/\1/p' "$log" | head -n 1 >"$memory"
  fi
  touch "$memory"
  if [ "$code" -ne 0 ]; then
    tail -n 20 "$log" >&2
    stop "Codex failed (code $code). Log: $(shown "$log")"
  fi
  cat "$answer"
}

case "${1:-}" in
  check)
    check_codex
    check_claude
    echo "OK: Codex on ChatGPT, Claude on claude.ai, API keys removed, spending guard passed."
    ;;
  read)
    prompt=$(message_file "$@") || exit 1
    talk read-only "$prompt"
    ;;
  code)
    prompt=$(message_file "$@") || exit 1
    talk workspace-write "$prompt"
    ;;
  review)
    [ $# -eq 2 ] || stop 'usage: codex-safe review <sha>'
    refuse_nested
    check_codex
    log=$(temporary duo-codex-review)
    reviews=$(memory_file codex-reviews)
    # As with conversations, forget reviews older than 12 hours.
    [ -n "$(recent_session codex-reviews)" ] || : >"$reviews"
    # shellcheck disable=SC2086
    safe_env "$CODEX" review $config $model --commit "$2" >"$log" 2>&1 </dev/null
    code=$?
    sed -n 's/^session id: //p' "$log" | head -n 1 >>"$reviews"
    tail -n 80 "$log"
    [ "$code" -eq 0 ] || stop "Codex failed (code $code). Log: $(shown "$log")"
    ;;
  forget)
    rm -f "$(memory_file codex)" "$(memory_file codex-reviews)"
    ;;
  *)
    stop 'usage: codex-safe check | read "message" | code "message" | review <sha> | forget'
    ;;
esac
