#!/bin/sh
# Appelle Claude uniquement avec le login claude.ai. Refuse et s'arrête sinon.
#
#   claude-safe lire  "message"  Claude lit et répond, sans rien modifier
#   claude-safe coder "message"  Claude modifie le projet, sans commiter ni pousser
#   claude-safe oublie           la prochaine demande repart de zéro
#
# Le message peut aussi venir de DUO_MESSAGE, sans le deuxième argument.
# Claude garde le fil de la conversation entre deux appels du même projet.
# Option : DUO_MODEL=<modèle> pour choisir un autre modèle.
set -u
. "$(dirname "$0")/commun.sh"

model=${DUO_MODEL:-opus}

talk() {
  refuse_nested
  check_claude
  memory=$(memory_file claude)
  session=$(recent_session claude)
  log=$(temporary duo-claude)
  mode=$1 prompt=$2
  set -- ${session:+--resume "$session"}
  if [ "$mode" = coder ]; then
    set -- "$@" --permission-mode acceptEdits --allowedTools Bash \
      --disallowedTools 'Bash(git push *),Bash(git merge *),Bash(git commit *),Bash(git rebase *),Bash(git reset *),Bash(git -C *),Bash(git -c *)'
  else
    set -- "$@" --permission-mode default --disallowedTools 'Write,Edit,NotebookEdit'
  fi
  safe_env "$CLAUDE" -p --model "$model" --output-format json "$@" >"$log" 2>&1 <"$prompt"
  code=$?
  run_python - "$log" "$memory" "$code" 2>/dev/null <<'EOF' || { tail -n 20 "$log" >&2; stop "Claude a échoué (code $code). Journal : $(shown "$log")"; }
import json, sys
log, memory, code = sys.argv[1:]
text = open(log, errors='replace').read()
result = json.loads(text[text.index('{'):])
# Noté même après un échec : l'appel a pu consommer des tokens.
if result.get('session_id'):
    open(memory, 'w').write(result['session_id'] + '\n')
if code != '0' or result.get('is_error'):
    sys.exit(1)
print(result['result'])
EOF
}

case "${1:-}" in
  lire|coder)
    prompt=$(message_file "$@") || exit 1
    talk "$1" "$prompt"
    ;;
  oublie)
    rm -f "$(memory_file claude)"
    ;;
  *)
    stop 'usage : claude-safe lire "message" | coder "message" | oublie'
    ;;
esac
