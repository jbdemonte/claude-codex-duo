#!/bin/sh
# Call Claude only with the claude.ai login. Refuse and stop otherwise.
#
#   claude-safe read  "message"  Claude reads and answers without changing anything
#   claude-safe code  "message"  Claude edits the project without committing or pushing
#   claude-safe forget           start fresh on the next request
#
# The message can also come from DUO_MESSAGE, without a second argument.
# Claude keeps the conversation between calls in the same project.
# Option: DUO_MODEL=<model> to choose another model.
set -u
. "$(dirname "$0")/common.sh"

model=${DUO_MODEL:-opus}

talk() {
  refuse_nested
  check_claude
  memory=$(memory_file claude)
  session=$(recent_session claude)
  log=$(temporary duo-claude)
  mode=$1 prompt=$2
  set -- ${session:+--resume "$session"}
  if [ "$mode" = code ]; then
    set -- "$@" --permission-mode acceptEdits --allowedTools Bash \
      --disallowedTools 'Bash(git push *),Bash(git merge *),Bash(git commit *),Bash(git rebase *),Bash(git reset *),Bash(git -C *),Bash(git -c *)'
  else
    set -- "$@" --permission-mode default --disallowedTools 'Write,Edit,NotebookEdit'
  fi
  safe_env "$CLAUDE" -p --model "$model" --output-format json "$@" >"$log" 2>&1 <"$prompt"
  code=$?
  run_python - "$log" "$memory" "$code" 2>/dev/null <<'EOF' || { tail -n 20 "$log" >&2; stop "Claude failed (code $code). Log: $(shown "$log")"; }
import json, sys
log, memory, code = sys.argv[1:]
text = open(log, errors='replace').read()
result = json.loads(text[text.index('{'):])
# Record even after a failure: the call may have used tokens.
if result.get('session_id'):
    open(memory, 'w').write(result['session_id'] + '\n')
if code != '0' or result.get('is_error'):
    sys.exit(1)
print(result['result'])
EOF
}

case "${1:-}" in
  read|code)
    prompt=$(message_file "$@") || exit 1
    talk "$1" "$prompt"
    ;;
  forget)
    rm -f "$(memory_file claude)"
    ;;
  *)
    stop 'usage: claude-safe read "message" | code "message" | forget'
    ;;
esac
