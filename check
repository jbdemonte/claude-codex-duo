#!/usr/bin/python3
"""Refuse a call whenever it might use anything outside the subscription.

    check codex [codex path]   login, request destination, and quota
    check claude               request destination and extra usage

Never show a setting's value. When in doubt, refuse: if an internal format
changes, calls stop instead of going through unchecked.
"""
import datetime
import glob
import json
import math
import os
import queue
import re
import signal
import subprocess
import sys
import tempfile
import threading
import time

# Beyond the quota, Codex draws on paid credits: stop before that.
CODEX_QUOTA_MAX = 95
# To override, the user must ask: the agent then prefixes the call with this variable.
OVERRIDE = "Overriding requires the user's explicit request (DUO_IGNORE_QUOTA=1)."
# Time allowed for the Codex server to start and return the quota.
CODEX_SERVER_DELAY = 15

WINDOWS = os.name == 'nt'
PROGRAM_DATA = os.environ.get('ProgramData', r'C:\ProgramData')
PROGRAM_FILES = os.environ.get('ProgramFiles', r'C:\Program Files')

# Read line by line: macOS Python has no TOML parser. Inactive profiles are also
# refused to stay on the safe side.
CODEX_REDIRECT = re.compile(r"""\s*(?:[\w."' -]+\.)?["']?(openai_base_url|chatgpt_base_url|profile|model_provider)["']?\s*=\s*(.*)""")
CLAUDE_REDIRECT = re.compile(r'ANTHROPIC_.*(BASE_URL|API_KEY|AUTH_TOKEN)|ANTHROPIC_PROFILE|AWS_BEARER_TOKEN_BEDROCK'
                             r'|CLAUDE_CONFIG_DIR|CLAUDE_CODE_USE_(ANTHROPIC_AWS|BEDROCK|FOUNDRY|MANTLE|VERTEX)')


def stop(message):
    sys.exit(f'STOP: {message}')


def home(path):
    return os.path.join(os.path.expanduser('~'), path)


def lines(path):
    # Codex compresses logs with zstd when a session ends and renames them to .zst.
    if not path.endswith('.zst'):
        yield from open(path, encoding='utf-8', errors='replace')
        return
    try:
        from compression import zstd
    except ImportError:
        stop('compressed Codex logs require Python 3.14 or later. Install it, then run ./install.sh again.')
    try:
        yield from zstd.open(path, 'rt', encoding='utf-8', errors='replace')
    except (EOFError, zstd.ZstdError):
        # The unreadable part could contain a newer reading.
        stop(f'unreadable Codex log, call refused: {path}')


def check_codex_login():
    try:
        auth = json.load(open(home('.codex/auth.json'), encoding='utf-8'))
    except (OSError, ValueError):
        auth = {}
    if auth.get('auth_mode') != 'chatgpt' or auth.get('OPENAI_API_KEY'):
        stop('Codex must use the ChatGPT login, without an API key.')


def check_codex_destination():
    # Codex ignores these keys in a project's .codex/config.toml.
    system = os.path.join(PROGRAM_DATA, 'OpenAI', 'Codex') if WINDOWS else '/etc/codex'
    for path in (home('.codex/config.toml'), home('.codex/managed_config.toml'),
                 os.path.join(system, 'config.toml'), os.path.join(system, 'managed_config.toml')):
        if not os.path.exists(path):
            continue
        for line in open(path, encoding='utf-8'):
            key = line.split('=', 1)[0]
            if '=' in line and '"' in key and '\\' in key:
                stop(f"escaped key in {path}: cannot check where it sends Codex.")
            found = CODEX_REDIRECT.match(line)
            if not found:
                continue
            value = found[2].split('#')[0].strip().strip('"\'')
            if found[1] != 'model_provider' or value != 'openai':
                stop(f"{found[1]} in {path} may send Codex outside the subscription.")


def last_reading(path):
    latest, limits = '', None
    for line in lines(path):
        if '"rate_limits"' not in line:
            continue
        try:
            event = json.loads(line)
        except ValueError:
            continue
        found = (event.get('payload') or {}).get('rate_limits')
        if found and event['timestamp'] > latest:
            latest, limits = event['timestamp'], found
    return latest, limits


def last_codex_limits():
    paths = glob.glob(home('.codex/sessions/*/*/*/rollout-*.jsonl*'))
    if WINDOWS:
        return last_codex_limits_windows(paths)
    # Only the latest 50 logs count: if readings disappear, calls are eventually refused.
    latest, limits = '', None
    for path in sorted(paths, key=os.path.getmtime, reverse=True)[:50]:
        modified = datetime.datetime.fromtimestamp(os.path.getmtime(path), datetime.timezone.utc)
        if modified.strftime('%Y-%m-%dT%H:%M:%S.%f') < latest:
            break  # This log and the following ones are older than the reading found.
        found = last_reading(path)
        if found[0] > latest:
            latest, limits = found
    return limits


def last_codex_limits_windows(paths):
    # On Windows, a log's modification time stays at its creation time, even when a
    # resumed session keeps writing to it. Only its size changes: read each log once, then
    # read it again only when its size changes. Keep each reading in this file.
    memory = home('.local/state/duo/codex-quota.json')
    try:
        known = json.load(open(memory, encoding='utf-8'))
    except (OSError, ValueError):
        known = {}
    readings = {}
    for path in paths:
        size = os.path.getsize(path)
        entry = known.get(path) if isinstance(known, dict) else None
        if not (isinstance(entry, list) and len(entry) == 3 and entry[0] == size and isinstance(entry[1], str)):
            entry = [size, *last_reading(path)]
        readings[path] = entry
    # One temporary file per call: two checks may run at once. If saving
    # fails, the next check will simply read more logs again.
    os.makedirs(os.path.dirname(memory), exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix='.quota-', dir=os.path.dirname(memory))
    try:
        with os.fdopen(descriptor, 'w', encoding='utf-8') as output:
            json.dump(readings, output)
        os.replace(temporary, memory)
    except OSError:
        os.unlink(temporary)  # Windows refuses to replace a file that another check is replacing at the same time.
    return max(((entry[1], entry[2]) for entry in readings.values()), default=('', None), key=lambda found: found[0])[1]


class Refused(Exception):
    pass


def ask_codex_server(codex):
    """Ask the Codex server for the account quota without calling a model."""
    if WINDOWS and not codex.lower().endswith(('.exe', '.cmd')):
        # Git Bash finds the sh script installed by npm; Windows can run its sibling instead.
        codex = next((codex + end for end in ('.exe', '.cmd') if os.path.exists(codex + end)), codex)
    # On macOS, use a separate process group to stop the server and its descendants together.
    server = subprocess.Popen([codex, '-c', 'forced_login_method="chatgpt"', '-c', 'model_provider="openai"',
                               'app-server'], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              start_new_session=True)
    received = queue.Queue()

    def read():
        for line in server.stdout:
            received.put(line)
        received.put(None)

    def send(message):
        server.stdin.write(json.dumps(message).encode() + b'\n')
        server.stdin.flush()

    def answer(number):
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                raise queue.Empty  # Even if the server is still sending messages.
            line = received.get(timeout=left)
            if line is None:
                raise EOFError
            try:
                message = json.loads(line)
            except ValueError:
                continue
            # The server also sends notifications and its own requests, which have a method.
            if isinstance(message, dict) and message.get('id') == number and 'method' not in message:
                if 'result' not in message:
                    raise Refused
                return message['result']

    threading.Thread(target=read, daemon=True).start()
    deadline = time.monotonic() + CODEX_SERVER_DELAY
    try:
        send({'method': 'initialize', 'id': 0, 'params': {'clientInfo': {'name': 'duo', 'title': 'duo', 'version': '1'}}})
        answer(0)
        send({'method': 'initialized', 'params': {}})
        send({'method': 'account/rateLimits/read', 'id': 1})
        return answer(1)
    finally:
        if WINDOWS:
            # Windows can find descendants, such as Node and Codex behind the npm launcher, only
            # while the launcher lives: stop everything as soon as the answer arrives. If the launcher
            # has already stopped on its own, its descendants may stay open.
            if server.poll() is None:
                subprocess.run(['taskkill', '/T', '/F', '/PID', str(server.pid)],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            # Closing its input stops the server. Kill anything left, including descendants.
            try:
                server.stdin.close()
                server.wait(timeout=3)
            except (OSError, subprocess.TimeoutExpired):
                pass
            try:
                os.killpg(server.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass  # The whole group has already stopped.
        if server.poll() is None:
            server.kill()
        server.wait()
        try:
            server.stdin.close()
        except OSError:
            pass


def live_codex_windows(codex):
    """The current quota, or None if the Codex server does not provide it."""
    try:
        limits = ask_codex_server(codex)
    except queue.Empty:
        reason = f'no answer within {CODEX_SERVER_DELAY} s'
    except EOFError:
        reason = "Codex stopped before answering"
    except Refused:
        reason = 'Codex refused the request'
    except OSError as error:
        reason = f'Codex cannot start ({type(error).__name__})'
    else:
        # Each limit provides both windows, null if absent: refuse if a field is missing.
        # The main limit must have at least one window.
        main = limits['rateLimits']
        if main is None or main['primary'] is None and main['secondary'] is None:
            stop('empty current Codex quota, call refused.')
        windows = []
        for bucket in (main, *(limits.get('rateLimitsByLimitId') or {}).values()):
            label = '' if bucket.get('limitId') in (None, 'codex') else f" (limit {bucket['limitId']})"
            if bucket.get('rateLimitReachedType'):
                stop(f"Codex reports a reached limit{label}; further usage may incur charges. {OVERRIDE}")
            for window in (bucket['primary'], bucket['secondary']):
                if window is not None:
                    windows.append((window['usedPercent'], window['resetsAt'], label, True))
        return windows
    print(f'Note: current Codex quota unavailable ({reason}), using the latest log reading.', file=sys.stderr)
    return None


def check_codex_quota():
    # Login and destination are still checked: only the quota is ignored.
    if os.environ.get('DUO_IGNORE_QUOTA') == '1':
        print("Warning: Codex quota guard disabled (DUO_IGNORE_QUOTA=1). Beyond the quota, this call draws "
              "on paid credits.", file=sys.stderr)
        return
    # Logs record the quota only after a call. Alone, they would never see an
    # early reset, since the guard refuses calls as long as they say 100%.
    windows = live_codex_windows(sys.argv[2]) if len(sys.argv) > 2 else None
    if windows is None:
        limits = last_codex_limits() or {}
        windows = [(window['used_percent'], window['resets_at'], '', False)
                   for window in (limits.get('primary'), limits.get('secondary')) if window is not None]
    if not windows:
        stop('unknown Codex quota: run codex manually once, then try again.')
    for used, reset, label, live in windows:
        if not (number(used) and (reset is None or number(reset))):
            stop('unreadable Codex quota, call refused.')
        # An old reading may predate a reset that has since happened. Use the current quota
        # as it is: the machine's clock may be fast.
        if used >= CODEX_QUOTA_MAX and (live or reset is None or reset > time.time()):
            date = 'unknown' if reset is None else datetime.datetime.fromtimestamp(reset).strftime('%Y-%m-%d %H:%M')
            stop(f"Codex quota at {used:.0f}%{label}; further usage may incur charges. "
                 f"Next reset: {date}. {OVERRIDE}")


def number(value):
    return type(value) in (int, float) and math.isfinite(value)


def claude_settings_files():
    root = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True).stdout.strip()
    yield home('.claude/settings.json')
    managed = ([os.path.join(PROGRAM_FILES, 'ClaudeCode'), os.path.join(PROGRAM_DATA, 'ClaudeCode')] if WINDOWS
               else ['/Library/Application Support/ClaudeCode'])
    for folder in managed:
        yield os.path.join(folder, 'managed-settings.json')
        yield from glob.glob(os.path.join(folder, 'managed-settings.d', '*.json'))
    for folder in {os.getcwd(), root or os.getcwd()}:
        yield os.path.join(folder, '.claude/settings.json')
        yield os.path.join(folder, '.claude/settings.local.json')


def check_claude_destination():
    for path in claude_settings_files():
        if not os.path.exists(path):
            continue
        settings = json.load(open(path, encoding='utf-8'))
        names = [name for name, value in (settings.get('env') or {}).items()
                 if value != '' and CLAUDE_REDIRECT.fullmatch(name)]
        if settings.get('apiKeyHelper'):
            names.append('apiKeyHelper')
        if names:
            stop(f"{', '.join(names)} in {path} may send Claude outside the subscription.")


def check_claude_usage():
    account = json.load(open(home('.claude.json'), encoding='utf-8')).get('oauthAccount') or {}
    if account.get('hasExtraUsageEnabled') is not False:
        stop("Claude extra usage enabled or unknown: disable it in claude.ai, Settings > Usage, then run claude auth login to update the local account.")


CHECKS = {
    'codex': (check_codex_login, check_codex_destination, check_codex_quota),
    'claude': (check_claude_destination, check_claude_usage),
}

try:
    for check in CHECKS[sys.argv[1]]:
        check()
except (AttributeError, IndexError, KeyError, OSError, TypeError, ValueError) as error:
    stop(f'cannot check ({type(error).__name__}), call refused.')
