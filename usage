#!/usr/bin/python3
"""Estimate token usage from local Claude and Codex logs.

Count the calling agent's session and its colleague's current conversation.
Call no model and say nothing about the remaining quota.
"""
import functools
import glob
import hashlib
import json
import os
import subprocess
import time


def lines(path):
    # Codex compresses logs with zstd when a session ends and renames them to .zst.
    if not path.endswith('.zst'):
        yield from open(path, encoding='utf-8', errors='replace')
        return
    try:
        from compression import zstd
    except ImportError:
        return  # Python is too old: skip this log.
    try:
        yield from zstd.open(path, 'rt', encoding='utf-8', errors='replace')
    except (EOFError, zstd.ZstdError):
        pass  # A log still being written may end partway through.


def entries(pattern):
    for path in glob.glob(os.path.expanduser(pattern)):
        for line in lines(path):
            try:
                yield json.loads(line)
            except ValueError:
                continue


def claude_tokens(session):
    # A message repeats for each content block: count it only once.
    usages = {}
    for pattern in (f'{session}.jsonl', f'{session}/subagents/*.jsonl'):
        for entry in entries(f'~/.claude/projects/*/{pattern}'):
            if entry.get('type') == 'assistant' and entry['message'].get('usage'):
                usages[entry['message'].get('id')] = entry['message']['usage']

    def total(key):
        return sum(usage.get(key, 0) for usage in usages.values())

    cached = total('cache_read_input_tokens')
    read = total('input_tokens') + cached + total('cache_creation_input_tokens')
    return read, cached, total('output_tokens')


@functools.cache
def codex_children():
    children = {}
    for path in glob.glob(os.path.expanduser('~/.codex/sessions/*/*/*/*.jsonl*')):
        try:
            meta = json.loads(next(lines(path))).get('payload') or {}
        except (StopIteration, ValueError):
            continue
        children.setdefault(meta.get('parent_thread_id'), []).append(meta.get('id'))
    return children


def codex_thread_tokens(thread):
    # Each event repeats the conversation total, including resumes: only the last one counts.
    usage = {}
    for entry in entries(f'~/.codex/sessions/*/*/*/*{thread}.jsonl*'):
        payload = entry.get('payload') or {}
        if payload.get('type') == 'token_count' and payload.get('info'):
            usage = payload['info']['total_token_usage']
    return usage.get('input_tokens', 0), usage.get('cached_input_tokens', 0), usage.get('output_tokens', 0)


def codex_tokens(session):
    # `codex review` and the automatic reviewer run in separate subagents.
    threads = [session]
    for thread in threads:
        threads += codex_children().get(thread, [])
    return [sum(values) for values in zip(*map(codex_thread_tokens, threads))]


def remembered(name):
    root = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True).stdout.strip()
    # On Windows, common.sh writes C:/... with forward slashes, like git.
    key = hashlib.sha256((root or os.getcwd().replace(os.sep, '/')).encode()).hexdigest()[:16]
    path = os.path.expanduser(f'~/.local/state/duo/{key}.{name}')
    try:
        # As in common.sh, forget conversations older than 12 hours.
        if time.time() - os.path.getmtime(path) > 12 * 3600:
            return []
        return open(path, encoding='utf-8').read().split()
    except OSError:
        return []


def show(label, count, sessions):
    if not sessions:
        print(f'{label}: not called')
        return
    totals = [sum(values) for values in zip(*map(count, sessions))]
    if not any(totals):
        print(f'{label}: unknown')
        return
    read, cached, generated = (f'{n:,}' for n in totals)
    print(f'{label}: {read} read, including {cached} cached, and {generated} generated')


thread = os.environ.get('CODEX_THREAD_ID')
session = os.environ.get('CLAUDE_CODE_SESSION_ID')
if thread:
    show('Codex, current session', codex_tokens, [thread])
    show('Claude, current conversation', claude_tokens, remembered('claude'))
elif session:
    show('Claude, current session', claude_tokens, [session])
    show('Codex, current conversation', codex_tokens, remembered('codex') + remembered('codex-reviews'))
else:
    print('Current session unknown.')
