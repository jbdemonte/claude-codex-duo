#!/usr/bin/python3
"""Refuse un appel dès qu'il pourrait sortir de l'abonnement.

    controle codex [chemin de codex]   login, destination des requêtes et quota
    controle claude                    destination des requêtes et usage supplémentaire

N'affiche jamais la valeur d'un réglage. Dans le doute, refuse : si un format
interne change, les appels s'arrêtent au lieu de passer sans contrôle.
"""
import datetime
import glob
import json
import math
import os
import queue
import re
import signal
import subprocess
import sys
import tempfile
import threading
import time

# Au-delà du quota, Codex puise dans les crédits payants : on s'arrête avant.
CODEX_QUOTA_MAX = 95
# Pour passer outre, l'utilisateur doit le demander : l'agent préfixe alors l'appel avec cette variable.
OVERRIDE = "Pour passer outre, l'utilisateur doit le demander explicitement (DUO_SANS_QUOTA=1)."
# Temps laissé au serveur de Codex pour démarrer et donner le quota.
CODEX_SERVER_DELAY = 15

WINDOWS = os.name == 'nt'
PROGRAM_DATA = os.environ.get('ProgramData', r'C:\ProgramData')
PROGRAM_FILES = os.environ.get('ProgramFiles', r'C:\Program Files')

# Lecture ligne à ligne : le Python de macOS n'a pas de parseur TOML. Un profil inactif est donc
# refusé lui aussi, ce qui va dans le sens de la prudence.
CODEX_REDIRECT = re.compile(r"""\s*(?:[\w."' -]+\.)?["']?(openai_base_url|chatgpt_base_url|profile|model_provider)["']?\s*=\s*(.*)""")
CLAUDE_REDIRECT = re.compile(r'ANTHROPIC_.*(BASE_URL|API_KEY|AUTH_TOKEN)|ANTHROPIC_PROFILE|AWS_BEARER_TOKEN_BEDROCK'
                             r'|CLAUDE_CONFIG_DIR|CLAUDE_CODE_USE_(ANTHROPIC_AWS|BEDROCK|FOUNDRY|MANTLE|VERTEX)')


def stop(message):
    sys.exit(f'ARRÊT : {message}')


def home(path):
    return os.path.join(os.path.expanduser('~'), path)


def lines(path):
    # Codex compresse ses journaux en zstd une fois la session finie, et les renomme en .zst.
    if not path.endswith('.zst'):
        yield from open(path, encoding='utf-8', errors='replace')
        return
    try:
        from compression import zstd
    except ImportError:
        stop('journaux Codex compressés : il faut Python 3.14 ou plus. Installe-le, puis relance ./install.sh.')
    try:
        yield from zstd.open(path, 'rt', encoding='utf-8', errors='replace')
    except (EOFError, zstd.ZstdError):
        # Un relevé plus récent pourrait se trouver dans la partie illisible.
        stop(f'journal Codex illisible, appel refusé : {path}')


def check_codex_login():
    try:
        auth = json.load(open(home('.codex/auth.json'), encoding='utf-8'))
    except (OSError, ValueError):
        auth = {}
    if auth.get('auth_mode') != 'chatgpt' or auth.get('OPENAI_API_KEY'):
        stop('Codex doit utiliser le login ChatGPT, sans clé API.')


def check_codex_destination():
    # Codex ignore ces clés dans le .codex/config.toml d'un projet.
    system = os.path.join(PROGRAM_DATA, 'OpenAI', 'Codex') if WINDOWS else '/etc/codex'
    for path in (home('.codex/config.toml'), home('.codex/managed_config.toml'),
                 os.path.join(system, 'config.toml'), os.path.join(system, 'managed_config.toml')):
        if not os.path.exists(path):
            continue
        for line in open(path, encoding='utf-8'):
            key = line.split('=', 1)[0]
            if '=' in line and '"' in key and '\\' in key:
                stop(f"clé avec échappement dans {path} : impossible de vérifier où elle envoie Codex.")
            found = CODEX_REDIRECT.match(line)
            if not found:
                continue
            value = found[2].split('#')[0].strip().strip('"\'')
            if found[1] != 'model_provider' or value != 'openai':
                stop(f"{found[1]} dans {path} peut envoyer Codex ailleurs que sur l'abonnement.")


def last_reading(path):
    latest, limits = '', None
    for line in lines(path):
        if '"rate_limits"' not in line:
            continue
        try:
            event = json.loads(line)
        except ValueError:
            continue
        found = (event.get('payload') or {}).get('rate_limits')
        if found and event['timestamp'] > latest:
            latest, limits = event['timestamp'], found
    return latest, limits


def last_codex_limits():
    paths = glob.glob(home('.codex/sessions/*/*/*/rollout-*.jsonl*'))
    if WINDOWS:
        return last_codex_limits_windows(paths)
    # Seuls les 50 derniers journaux comptent : si les relevés disparaissent, l'appel finit refusé.
    latest, limits = '', None
    for path in sorted(paths, key=os.path.getmtime, reverse=True)[:50]:
        modified = datetime.datetime.fromtimestamp(os.path.getmtime(path), datetime.timezone.utc)
        if modified.strftime('%Y-%m-%dT%H:%M:%S.%f') < latest:
            break  # Ce journal et les suivants sont plus anciens que le relevé trouvé.
        found = last_reading(path)
        if found[0] > latest:
            latest, limits = found
    return limits


def last_codex_limits_windows(paths):
    # Sous Windows, la date de modification d'un journal reste celle de sa création, même quand une
    # session reprise y écrit encore. Seule sa taille change : chaque journal est lu une fois, puis
    # relu seulement quand sa taille change. Le relevé de chacun est gardé dans ce fichier.
    memory = home('.local/state/duo/quota-codex.json')
    try:
        known = json.load(open(memory, encoding='utf-8'))
    except (OSError, ValueError):
        known = {}
    readings = {}
    for path in paths:
        size = os.path.getsize(path)
        entry = known.get(path) if isinstance(known, dict) else None
        if not (isinstance(entry, list) and len(entry) == 3 and entry[0] == size and isinstance(entry[1], str)):
            entry = [size, *last_reading(path)]
        readings[path] = entry
    # Un fichier temporaire par appel : deux contrôles peuvent tourner en même temps. Si la sauvegarde
    # échoue, le prochain contrôle relira simplement plus de journaux.
    os.makedirs(os.path.dirname(memory), exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix='.quota-', dir=os.path.dirname(memory))
    try:
        with os.fdopen(descriptor, 'w', encoding='utf-8') as output:
            json.dump(readings, output)
        os.replace(temporary, memory)
    except OSError:
        os.unlink(temporary)  # Windows refuse de remplacer un fichier qu'un autre contrôle remplace au même moment.
    return max(((entry[1], entry[2]) for entry in readings.values()), default=('', None), key=lambda found: found[0])[1]


class Refused(Exception):
    pass


def ask_codex_server(codex):
    """Demande le quota au serveur de Codex, qui le lit sur le compte sans appeler de modèle."""
    if WINDOWS and not codex.lower().endswith(('.exe', '.cmd')):
        # Git Bash trouve le script sh installé par npm, que Windows ne lance pas : son voisin, si.
        codex = next((codex + end for end in ('.exe', '.cmd') if os.path.exists(codex + end)), codex)
    # Sous macOS, un groupe de processus à lui : le serveur et ses descendants s'arrêtent ensemble.
    server = subprocess.Popen([codex, '-c', 'forced_login_method="chatgpt"', '-c', 'model_provider="openai"',
                               'app-server'], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              start_new_session=True)
    received = queue.Queue()

    def read():
        for line in server.stdout:
            received.put(line)
        received.put(None)

    def send(message):
        server.stdin.write(json.dumps(message).encode() + b'\n')
        server.stdin.flush()

    def answer(number):
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                raise queue.Empty  # Même si le serveur envoie encore des messages.
            line = received.get(timeout=left)
            if line is None:
                raise EOFError
            try:
                message = json.loads(line)
            except ValueError:
                continue
            # Le serveur envoie aussi des notifications et ses propres requêtes, qui ont une méthode.
            if isinstance(message, dict) and message.get('id') == number and 'method' not in message:
                if 'result' not in message:
                    raise Refused
                return message['result']

    threading.Thread(target=read, daemon=True).start()
    deadline = time.monotonic() + CODEX_SERVER_DELAY
    try:
        send({'method': 'initialize', 'id': 0, 'params': {'clientInfo': {'name': 'duo', 'title': 'duo', 'version': '1'}}})
        answer(0)
        send({'method': 'initialized', 'params': {}})
        send({'method': 'account/rateLimits/read', 'id': 1})
        return answer(1)
    finally:
        if WINDOWS:
            # Windows ne retrouve les descendants, comme Node et Codex derrière le lanceur npm, que
            # tant que le lanceur vit : tout est arrêté dès la réponse. Si le lanceur s'est arrêté
            # seul avant ses descendants, ceux-ci peuvent rester ouverts.
            if server.poll() is None:
                subprocess.run(['taskkill', '/T', '/F', '/PID', str(server.pid)],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            # Fermer son entrée arrête le serveur. Ce qui traîne ensuite est tué, descendants compris.
            try:
                server.stdin.close()
                server.wait(timeout=3)
            except (OSError, subprocess.TimeoutExpired):
                pass
            try:
                os.killpg(server.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass  # Tout le groupe est déjà arrêté.
        if server.poll() is None:
            server.kill()
        server.wait()
        try:
            server.stdin.close()
        except OSError:
            pass


def live_codex_windows(codex):
    """Le quota à jour, ou None si le serveur de Codex ne le donne pas."""
    try:
        limits = ask_codex_server(codex)
    except queue.Empty:
        reason = f'pas de réponse en {CODEX_SERVER_DELAY} s'
    except EOFError:
        reason = "Codex s'est arrêté avant de répondre"
    except Refused:
        reason = 'Codex a refusé la demande'
    except OSError as error:
        reason = f'Codex ne se lance pas ({type(error).__name__})'
    else:
        # Chaque limite donne ses deux fenêtres, null si elle n'en a pas : un champ absent fait refuser.
        # La limite principale doit en avoir au moins une.
        main = limits['rateLimits']
        if main is None or main['primary'] is None and main['secondary'] is None:
            stop('quota Codex à jour vide, appel refusé.')
        windows = []
        for bucket in (main, *(limits.get('rateLimitsByLimitId') or {}).values()):
            label = '' if bucket.get('limitId') in (None, 'codex') else f" (limite {bucket['limitId']})"
            if bucket.get('rateLimitReachedType'):
                stop(f"Codex signale une limite atteinte{label}, au-delà l'usage peut devenir payant. {OVERRIDE}")
            for window in (bucket['primary'], bucket['secondary']):
                if window is not None:
                    windows.append((window['usedPercent'], window['resetsAt'], label, True))
        return windows
    print(f'Note : quota Codex à jour indisponible ({reason}), dernier relevé des journaux utilisé.', file=sys.stderr)
    return None


def check_codex_quota():
    # Le login et la destination restent contrôlés : seul le quota est ignoré.
    if os.environ.get('DUO_SANS_QUOTA') == '1':
        print("Attention : verrou du quota Codex coupé (DUO_SANS_QUOTA=1). Au-delà du quota, l'appel puise "
              "dans les crédits payants.", file=sys.stderr)
        return
    # Les journaux ne notent le quota qu'après un appel. Seuls, ils ne verraient jamais un
    # renouvellement anticipé, puisque le verrou refuse les appels tant qu'ils disent 100 %.
    windows = live_codex_windows(sys.argv[2]) if len(sys.argv) > 2 else None
    if windows is None:
        limits = last_codex_limits() or {}
        windows = [(window['used_percent'], window['resets_at'], '', False)
                   for window in (limits.get('primary'), limits.get('secondary')) if window is not None]
    if not windows:
        stop('quota Codex inconnu : lance une fois codex à la main, puis recommence.')
    for used, reset, label, live in windows:
        if not (number(used) and (reset is None or number(reset))):
            stop('quota Codex illisible, appel refusé.')
        # Un relevé ancien peut dater d'avant un renouvellement passé depuis. Le quota à jour, lui,
        # compte tel quel : l'horloge de la machine peut avancer.
        if used >= CODEX_QUOTA_MAX and (live or reset is None or reset > time.time()):
            date = 'inconnu' if reset is None else datetime.datetime.fromtimestamp(reset).strftime('%d/%m à %H:%M')
            stop(f"quota Codex à {used:.0f} %{label}, au-delà l'usage peut devenir payant. "
                 f"Prochain renouvellement : {date}. {OVERRIDE}")


def number(value):
    return type(value) in (int, float) and math.isfinite(value)


def claude_settings_files():
    root = subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True).stdout.strip()
    yield home('.claude/settings.json')
    managed = ([os.path.join(PROGRAM_FILES, 'ClaudeCode'), os.path.join(PROGRAM_DATA, 'ClaudeCode')] if WINDOWS
               else ['/Library/Application Support/ClaudeCode'])
    for folder in managed:
        yield os.path.join(folder, 'managed-settings.json')
        yield from glob.glob(os.path.join(folder, 'managed-settings.d', '*.json'))
    for folder in {os.getcwd(), root or os.getcwd()}:
        yield os.path.join(folder, '.claude/settings.json')
        yield os.path.join(folder, '.claude/settings.local.json')


def check_claude_destination():
    for path in claude_settings_files():
        if not os.path.exists(path):
            continue
        settings = json.load(open(path, encoding='utf-8'))
        names = [name for name, value in (settings.get('env') or {}).items()
                 if value != '' and CLAUDE_REDIRECT.fullmatch(name)]
        if settings.get('apiKeyHelper'):
            names.append('apiKeyHelper')
        if names:
            stop(f"{', '.join(names)} dans {path} peut envoyer Claude ailleurs que sur l'abonnement.")


def check_claude_usage():
    account = json.load(open(home('.claude.json'), encoding='utf-8')).get('oauthAccount') or {}
    if account.get('hasExtraUsageEnabled') is not False:
        stop("usage supplémentaire Claude activé ou inconnu : coupe-le dans claude.ai, Settings > Usage, puis lance claude auth login pour mettre à jour le compte local.")


CHECKS = {
    'codex': (check_codex_login, check_codex_destination, check_codex_quota),
    'claude': (check_claude_destination, check_claude_usage),
}

try:
    for check in CHECKS[sys.argv[1]]:
        check()
except (AttributeError, IndexError, KeyError, OSError, TypeError, ValueError) as error:
    stop(f'contrôle impossible ({type(error).__name__}), appel refusé.')
